# Copy to .env and set real values. Never commit .env.
MSSQL_SA_PASSWORD=change-me-to-a-strong-password
DATABASE_URL=mssql+aioodbc://sa:${MSSQL_SA_PASSWORD}@db:1433/ErpDb?driver=ODBC+Driver+18+for+SQL+Server&TrustServerCertificate=yes
REDIS_URL=redis://redis:6379/0
JWT_SECRET=generate-a-long-random-string
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
NEXT_PUBLIC_API_URL=http://localhost:8000
