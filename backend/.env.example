# Copy to .env for local development. Never commit .env.
NODE_ENV=development
PORT=8000
# Neon: use the POOLED connection string here (host contains "-pooler").
DATABASE_URL=postgresql://erpatio_owner:change-me@localhost:5432/erpatio
# Neon: use the DIRECT (non-pooled) string for migrations and seeding.
DATABASE_URL_DIRECT=postgresql://erpatio_owner:change-me@localhost:5432/erpatio
# 32+ random characters: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-dev-only-secret
# Set during key rotation so tokens signed with the old key stay valid until they expire.
# JWT_SECRET_PREVIOUS=
COOKIE_SECURE=false
# 32 random bytes, base64. Protects field-level encryption. LOSING IT MAKES ENCRYPTED DATA UNREADABLE: keep a copy.
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# MASTER_KEY=
# During rotation set the old key here, run `npm run keys:rewrap`, then remove it.
# MASTER_KEY_PREVIOUS=
# Where emailed links point (the web app's address).
APP_URL=http://localhost:5173
# Outgoing mail. Without it, messages are held in memory (development) and sign-up cannot be opened in production.
# SMTP_URL=smtps://user:password@smtp.example.com:465
MAIL_FROM=ERPatio <no-reply@localhost>
# Open self-service sign-up (needs SMTP_URL in production).
SIGNUP_ENABLED=true
# Breached-password check via the Have I Been Pwned range API (only a 5-character hash prefix is sent).
HIBP_ENABLED=true
DOCS_ENABLED=true
DEMO_MAX_ENTRIES=100
# Demo workspace: synthetic data only, credentials intentionally public (ADR-008).
# DEMO_PASSWORD=
